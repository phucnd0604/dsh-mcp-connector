{
  "schemaVersion": 1,
  "id": "vendor-service",
  "name": "Vendor · Service Name",
  "vendor": "Vendor name",
  "icon": "https://example.com/icon.svg",
  "category": "开发工具",
  "summary": "One sentence describing what the connector can do",
  "description": "Full description, applicable scenarios and data coverage.",
  "tags": ["Sample"],
  "published": true,
  "featured": false,
  "homepage": "https://example.com",
  "probeStatus": "unverified",
  "auth": {
    "mode": "none"
  },
  "servers": [
    {
      "serverKey": "main",
      "url": "https://mcp.example.com/stream",
      "serverName": "vendor-service",
      "transport": "streamable-http"
    },
    {
      "serverKey": "local-example",
      "serverName": "vendor-local-example",
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@vendor/example-mcp-server"],
      "env": {
        "LOG_LEVEL": "info"
      }
    }
  ],
  "promptVariables": [
    {
      "name": "topic",
      "label": "Query topic",
      "placeholder": "e.g. quarterly business review",
      "required": true
    }
  ],
  "prompts": [
    {
      "title": "Quick lookup",
      "text": "Look up {{topic}} for me"
    }
  ]
}